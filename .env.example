# --- Aplicación ---
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# true detrás de HTTPS (producción); false para http://localhost
COOKIE_SECURE=false
# Duración de la sesión en segundos (opcional, por defecto 86400 = 24 h)
# SESSION_MAX_AGE=86400

# --- Base de datos ---
# Generar: openssl rand -hex 32
POSTGRES_PASSWORD=
# Opcionales (por defecto: naviusm)
# POSTGRES_USER=naviusm
# POSTGRES_DB=naviusm
# Solo para correr la app FUERA de Docker; dentro de Docker la define docker-compose.yml
# DATABASE_URL=postgresql://naviusm:<POSTGRES_PASSWORD>@localhost:5432/naviusm

# --- Puerto publicado en el host (opcional, por defecto 8000) ---
# NAVIUSM_PORT=8000

# --- Seed inicial (python seed.py) ---
ORG_NOMBRE=
# Solo minúsculas, números y guiones. Ej: mi-universidad
ORG_SLUG=
ADMIN_EMAIL=
# Mínimo 12 caracteres
ADMIN_PASSWORD=