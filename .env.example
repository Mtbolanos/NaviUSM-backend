# --- Aplicación ---
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# true detrás de HTTPS (producción); false para http://localhost
COOKIE_SECURE=false
# Duración de la sesión en segundos (opcional, por defecto 86400 = 24 h)
# SESSION_MAX_AGE=86400

# --- Base de datos ---
# Generar: openssl rand -hex 32
POSTGRES_PASSWORD=
# Opcionales (por defecto: naviusm)
# POSTGRES_USER=naviusm
# POSTGRES_DB=naviusm
# Solo para correr la app FUERA de Docker; dentro de Docker la define docker-compose.yml
# DATABASE_URL=postgresql://naviusm:<POSTGRES_PASSWORD>@localhost:5432/naviusm

# --- Puerto publicado en el host (opcional, por defecto 8000) ---
# NAVIUSM_PORT=8000

# --- Seed inicial (python seed.py) ---
ORG_NOMBRE=
# Solo minúsculas, números y guiones. Ej: mi-universidad
ORG_SLUG=
ADMIN_EMAIL=
# Mínimo 12 caracteres
ADMIN_PASSWORD=

# --- API móvil (opcionales) ---
# Duración del token de sesión de la app en segundos (por defecto 3600)
# MOBILE_SESSION_TTL=3600
# true para exponer /docs y /redoc con la documentación de la API móvil (recomendado solo en desarrollo)
# API_DOCS=false

# --- Buscador de lugares (opcionales) ---
# URL de Photon (por defecto el servidor público; para mucho volumen, una instancia propia)
# GEOCODER_URL=https://photon.komoot.io/api/
# País al que se restringe la búsqueda (ISO 3166-1 alfa-2)
# GEOCODER_COUNTRY=CL
# GEOCODER_USER_AGENT=NaviUSM/1.0

# --- Mapa base (opcionales) ---
# Servidor de mosaicos. tile.openstreetmap.org no garantiza servicio: para uso comercial o mucho volumen,
# un proveedor propio o de terceros. Al cambiarlo, ajustar también la atribución que exige ese proveedor.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# MAP_TILE_MAX_ZOOM=19
# Mapa vectorial (nítido a cualquier zoom). Dejar vacío para usar solo el raster de arriba:
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# MAP_STYLE_ATTRIBUTION=<a href="https://openfreemap.org">OpenFreeMap</a> &copy; OpenMapTiles Datos de OpenStreetMap